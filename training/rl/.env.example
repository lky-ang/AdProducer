# Copy to .env, fill in, then: set -a; source .env; set +a   (read by train_rl.sh)

# --- agent tools ---
SERPER_KEY_ID=                                      # google.serper.dev: search + image_search
TEXT_SEARCH_API_BASE_URL=https://google.serper.dev/search
IMAGE_SEARCH_API_BASE_URL=https://google.serper.dev/images
JINA_API_KEYS=                                      # r.jina.ai page reader: browse
BROWSE_SUMMARY_BASE_URL=http://browse-host:8001/v1  # OpenAI-compatible server summarising browsed pages
BROWSE_SUMMARY_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
BROWSE_SUMMARY_API_KEY=EMPTY

# --- MiniMax H3 reference-to-video servers (sglang serve --model-variant ref2va), comma separated ---
H3_URLS=http://h3-a:30011,http://h3-b:30011

# --- judge (Gemini 3.1 Pro) for both rewards ---
# Google AI Studio:            JUDGE_BACKEND=gemini, JUDGE_MODEL=gemini-3.1-pro-preview, JUDGE_BASE_URL empty
# OpenAI-compatible gateway:   JUDGE_BACKEND=openai, JUDGE_BASE_URL=<gateway>/v1, JUDGE_AUTH_HEADER as the gateway needs
JUDGE_BACKEND=gemini
JUDGE_MODEL=gemini-3.1-pro-preview
JUDGE_API_KEY=
JUDGE_AUTH_HEADER=Authorization
JUDGE_BASE_URL=

# --- reward ---
GEN_REWARD_TEXT_COEF=0.5        # R = (1 - a) R_video + a R_text; 1.0 = text reward only (quick test without H3)

# --- data (see README): gt_video/ and cached_image/ from AdProducer/AdProducer-Train-Data ---
# ADP_DATA_DIR=
# ADP_WORK_DIR=
# WANDB_API_KEY=
