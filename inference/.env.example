# copy to .env, fill in, then: set -a; . ./.env; set +a
# --- step 2: brief writer (any OpenAI-compatible chat endpoint) ---
BRIEF_BASE_URL=https://api.openai.com/v1
BRIEF_MODEL=gpt-4.1
BRIEF_API_KEY=
# BRIEF_AUTH_HEADER=Authorization         # header name, if your gateway needs another one
# --- step 3: search agent ---
POLICY_BASE_URL=http://127.0.0.1:8000/v1   # scripts/serve_policy.sh
POLICY_MODEL=adproducer
SERPER_KEY_ID=                             # google.serper.dev (search + image_search)
JINA_API_KEYS=                             # r.jina.ai page reader (browse)
BROWSE_SUMMARY_BASE_URL=                   # OpenAI-compatible model that summarises browsed pages
BROWSE_SUMMARY_MODEL=
BROWSE_SUMMARY_API_KEY=
# --- step 4: MiniMax H3 ---
H3_URLS=http://127.0.0.1:30011             # scripts/serve_h3.sh
H3_SEED=1101
H3_SHORT_EDGE=480
H3_TIMEOUT_S=7200
